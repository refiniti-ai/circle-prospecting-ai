{
  "name": "circle-prospecting-ai",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n client,api -c cyan,magenta \"npm run dev:vite\" \"npm run dev:api\"",
    "dev:vite": "vite",
    "dev:api": "tsx watch server/index.ts",
    "build": "tsc -b && vite build",
    "serve:hosting": "npm run build && firebase serve",
    "preview": "vite preview",
    "start:api": "tsx server/index.ts",
    "start": "tsx server/index.ts",
    "firestore:smoke": "tsx scripts/firestore-smoke.ts",
    "workflow:check": "tsx scripts/client-workflow-check.ts",
    "lint": "tsc -b --noEmit",
    "build:geo": "node scripts/build-us-geo.mjs"
  },
  "dependencies": {
    "@react-google-maps/api": "^2.20.3",
    "cors": "^2.8.5",
    "csv-parse": "^5.5.6",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "firebase-admin": "^13.8.0",
    "helmet": "^8.0.0",
    "jose": "^5.9.6",
    "multer": "^2.0.0",
    "nodemailer": "^6.9.16",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^2.0.5",
    "react-router-dom": "^6.28.0",
    "stripe": "^17.7.0",
    "tsx": "^4.19.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^9.0.1",
    "typescript": "~5.6.2",
    "vite": "^5.4.10"
  }
}
