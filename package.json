{
  "name": "circle-prospecting-ai",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n client,api -c cyan,magenta \"npm run dev:vite\" \"npm run dev:api\"",
    "dev:next": "npm run dev --prefix next-app",
    "dev:next+api": "concurrently -k -n api,next -c magenta,cyan \"npm run dev:api\" \"npm run dev:next\"",
    "build:next": "npm run build --prefix next-app",
    "deploy:firebase:rules": "firebase deploy --only firestore:rules,firestore:indexes,storage",
    "deploy:gcloud": "gcloud run deploy circle-prospecting-ai-git --source . --region us-central1 --allow-unauthenticated --project circle-prospecting-ai --port 8080",
    "build:favicon": "node scripts/build-favicon.mjs",
    "build:preview-image": "node scripts/build-preview-image.mjs",
    "facebook:scrape": "node scripts/facebook-scrape-urls.mjs",
    "deploy:hosting": "npm run build && firebase deploy --only hosting",
    "deploy:production": "npm run build && firebase deploy --only hosting && npm run deploy:gcloud",
    "dev:vite": "vite",
    "dev:api": "tsx watch server/index.ts",
    "build": "tsc -b && vite build",
    "serve:hosting": "npm run build && firebase serve",
    "preview": "vite preview",
    "start:api": "tsx server/index.ts",
    "start": "tsx server/index.ts",
    "firestore:smoke": "tsx scripts/firestore-smoke.ts",
    "workflow:check": "tsx scripts/client-workflow-check.ts",
    "lint": "tsc -b --noEmit",
    "build:geo": "node scripts/build-us-geo.mjs"
  },
  "dependencies": {
    "@react-google-maps/api": "^2.20.3",
    "axios": "^1.16.1",
    "cors": "^2.8.5",
    "csv-parse": "^5.5.6",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "firebase-admin": "^13.8.0",
    "helmet": "^8.0.0",
    "jose": "^5.9.6",
    "multer": "^2.0.0",
    "nodemailer": "^6.9.16",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^2.0.5",
    "react-hot-toast": "^2.6.0",
    "react-router-dom": "^6.28.0",
    "stripe": "^17.7.0",
    "tsx": "^4.19.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^9.0.1",
    "sharp": "^0.33.5",
    "typescript": "~5.6.2",
    "vite": "^5.4.10"
  }
}
