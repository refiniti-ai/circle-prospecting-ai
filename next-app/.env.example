# --- Local dev: proxy /api/* to existing Express (repo root npm run dev:api) ---
# API_PROXY_TARGET=http://127.0.0.1:8787

# --- Client (NEXT_PUBLIC_*) ---
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Server-only (App Hosting console / secrets; never commit real values) ---
# STRIPE_SECRET_KEY=
# FIREBASE_SERVICE_ACCOUNT_PATH= (or use ADC / FIREBASE_CONFIG on App Hosting)
