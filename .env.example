# —— Client (Vite) ——
VITE_GOOGLE_MAPS_API_KEY=
# Base URL where the Express API runs (no trailing slash). Build-time only.
# Firebase Hosting https://circle-prospecting-ai.web.app/ serves static files only — it does NOT run /api.
# Use your real API origin (Cloud Run, VM, Render, etc.) OR add Hosting rewrites to Cloud Functions.
VITE_API_BASE_URL=
VITE_CONTACT_EMAIL=hello@circleprospecting.ai
# Show /admin/leads in production (optional; always visible in dev)
# VITE_SHOW_ADMIN=1

API_PORT=8787

# —— Public site URL (Stripe redirects, must match the URL you open in the browser) ——
APP_PUBLIC_URL=http://localhost:5173

# —— API server (secrets; never commit .env) ——
# Stripe TEST keys: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_xxxxxxxx
# https://dashboard.stripe.com/test/webhooks — or from `stripe listen` CLI
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxx

# For dashboard JWT signing (32+ random chars in production)
DASHBOARD_JWT_SECRET=change-me-to-a-long-random-string-for-production

# Admin CSV upload: send Authorization: Bearer <this> from the Admin page
ADMIN_API_KEY=change-me-long-random-admin-key

# Optional: HMAC for POST /api/new-listing
# INBOUND_HMAC_SECRET=

# Optional GHL step-2 integration (provide webhook/API URLs that your GHL automation listens to)
# GHL_UPSERT_CONTACT_URL=
# GHL_CREATE_OPPORTUNITY_URL=
# GHL_BEARER_TOKEN=

# Optional Firebase Firestore order storage (if set, orders write/read from Firestore first, with local fallback).
# Console → Project settings → Service accounts → Generate new private key (JSON). Same as:
#   admin.credential.cert(require("./serviceAccountKey.json"))
# Either FIREBASE_SERVICE_ACCOUNT_JSON (whole JSON string) or FIREBASE_SERVICE_ACCOUNT_PATH (file path from repo root).
# FIREBASE_PROJECT_ID=circle-prospecting-ai
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/serviceAccountKey.json
# On Cloud Run / GAE / many Functions, ADC is auto-detected. Locally: use JSON path, or gcloud +:
# FIREBASE_USE_ADC=1
# FIREBASE_ORDERS_COLLECTION=orders

# Optional SMTP for marketing email send (if not set, email is logged in API console)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=no-reply@circleprospecting.ai
# Comma-separated internal recipients for purchase alerts
# PURCHASE_NOTIFICATION_EMAIL=owner@circleprospecting.ai,ops@circleprospecting.ai

# Upstream order API (optional)
# ORDER_UPSTREAM_URL=
# ORDER_UPSTREAM_TOKEN=

# Lead pack pricing (cents per pack) — first number is count of leads, second is price
LEAD_PACKS=10:9900,25:19900,50:34900,100:59900

# CORS for production — must include every browser origin that calls your API:
# https://circle-prospecting-ai.web.app
# https://circleprospecting.ai (etc.)
# CORS_ORIGIN=https://circle-prospecting-ai.web.app,http://localhost:5173
