# —— Client (Vite) ——
# Google Maps browser key (address autocomplete + map preview on Buy Leads).
# Create in Google Cloud → APIs & Services → Credentials → Create API key (Browser).
# Enable: Maps JavaScript API + Places API. Link billing to the project.
# Restrict the key → HTTP referrers:
#   https://circleprospecting.ai/*
#   https://www.circleprospecting.ai/*
#   https://circle-prospecting-ai.web.app/*
#   https://circle-prospecting-ai.firebaseapp.com/*
#   http://localhost:5173/*
# Set here for local dev; must also be present when you run `npm run build` (Vite bakes it into the JS bundle).
VITE_GOOGLE_MAPS_API_KEY=
# Same key on Cloud Run for server-side /api/geocode (recommended for Find listing map accuracy).
# GOOGLE_MAPS_API_KEY=
# Beta checkout — promo code BetaCPAI locks Live Callers at $0.50/home (optional override).
# VITE_BETA_PROMO_CODE=BetaCPAI
# Hide non–Live Callers products on Buy Leads / pay link during beta. Set to false to restore all products.
# VITE_BETA_HIDE_AI_HYBRID=false
# Optional. Leave empty to use same-origin `/api/*`:
#   • Local: Vite proxies /api → API_PORT (see vite.config.ts).
#   • Production on Firebase Hosting: default firebase.json does NOT rewrite /api to Cloud Run.
#     Set VITE_API_BASE_URL to your public HTTPS API (e.g. https://circle-prospecting-api-xxxxx-uc.a.run.app),
#     then npm run build && firebase deploy --only hosting. On the API set CORS_ORIGIN to your *.web.app origin.
#     Same-domain /api is optional: deploy Cloud Run, then add the /api/** → Run rewrite back (see docs/firebase-phase1-deploy.md).
# NEVER bake http://localhost:8787 into a production build for *.web.app — checkout will fail.
VITE_API_BASE_URL=
# Optional: `.env.production` (committed) supplies VITE_* for `npm run build` on CI — see repo root `.env.production` example.
VITE_CONTACT_EMAIL=hello@circleprospecting.ai
# Cal.com booking link for header / homepage “Book call” CTAs (defaults to Greg’s 15-min event).
# VITE_BOOK_CALL_URL=https://cal.com/circleprospectingai-greg/15min
# Contact page (/contact): primary inbox shown in UI (align with server CONTACT_INBOX_EMAIL for where form mail goes).
# VITE_CONTACT_INBOX_EMAIL=info@circleprospecting.ai
# Pipe-separated address lines, e.g. VITE_CONTACT_ADDRESS=123 Main St|Austin, TX 78701
# VITE_CONTACT_ADDRESS=
# VITE_CONTACT_PHONE=+1 (555) 123-4567
# Optional social buttons (HTTPS URLs):
# VITE_SOCIAL_LINKEDIN=https://www.linkedin.com/company/...
# VITE_SOCIAL_X=https://x.com/...
# VITE_SOCIAL_FACEBOOK=https://www.facebook.com/...
# VITE_SOCIAL_INSTAGRAM=https://www.instagram.com/...
# Optional — only if you add Stripe.js in the browser (Checkout redirect does not need this today)
# VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxx
# Admin UI is available in production; access is enforced by server (admin login / JWT).

API_PORT=8787

# —— Public site URL (Stripe redirects, must match the URL you open in the browser) ——
# Production site URL (Stripe redirects, GHL pay links, must match the URL users open in the browser).
# Custom domain: https://circleprospecting.ai (also add www in Firebase Hosting if you use it).
APP_PUBLIC_URL=https://circleprospecting.ai

# —— API server (secrets; never commit .env) ——
# Stripe TEST keys: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_xxxxxxxx
# https://dashboard.stripe.com/test/webhooks — or from `stripe listen` CLI
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxx

# Optional: custom JWT signing key for dashboard/admin sessions (otherwise the API uses a built-in default).
# DASHBOARD_JWT_SECRET=

# Admin: username/password on /login?tab=admin → server returns a short-lived JWT.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
# Admin “forgot password” — must match the email you type on the login page; reset links are sent here.
# ADMIN_EMAIL=you@yourdomain.com
# Optional legacy: static Bearer for scripts/curl only — browser admin UI uses JWT from login instead.
# ADMIN_API_KEY=

# --- Lead packs + client dashboard (typical) ---
# Set on the API: STRIPE_SECRET_KEY, ADMIN_PASSWORD, APP_PUBLIC_URL (live site URL). Optional: DASHBOARD_JWT_SECRET.
# Same-domain Hosting→Cloud Run: leave VITE_API_BASE_URL empty when you build the SPA.
# STRIPE_WEBHOOK_SECRET on the API for purchase webhooks; point Stripe to https://circleprospecting.ai/api/webhooks/stripe
# Enable checkout.session.completed and checkout.session.expired for cart abandonment metrics.
# Optional: Firestore vars below for purchase log + delivered leads; INBOUND_HMAC + POST /api/new-listing for listing ingest.

# Optional: HMAC for POST /api/new-listing
# INBOUND_HMAC_SECRET=

# Beta checkout (server validates promo for Live Callers; Live Callers + Data Only when AI/Hybrid hidden).
# BETA_PROMO_CODE=BetaCPAI
# BETA_HIDE_AI_HYBRID=false   # set to false to show AI, Hybrid, Data, and Live at checkout

# Upstream order API (optional)
# ORDER_UPSTREAM_URL=
# ORDER_UPSTREAM_TOKEN=

# Lead pack pricing (cents per pack) — first number is count of leads, second is price
LEAD_PACKS=10:9900,25:19900,50:34900,100:59900

# Checkout inventory floor — buyers can purchase up to this many homes even if Admin CSV has fewer rows (default 8000).
# LEAD_CHECKOUT_INVENTORY_MIN=8000

# CORS for production — include custom domain + Firebase backup + local dev:
# CORS_ORIGIN=https://circleprospecting.ai,https://www.circleprospecting.ai,https://circle-prospecting-ai.web.app,http://localhost:5173

# Housing Leads RDS. User `circle`. Listings: roofs. Business data: circle (empty until schema applied).
# Private DB — App Runner needs a VPC connector + NAT. Do not use the RDS master password.
# ROOFS_DB_HOST=new-production.cg2uhqhfvzae.us-east-2.rds.amazonaws.com
# ROOFS_DB_PORT=3306
# ROOFS_DB_NAME=roofs
# ROOFS_DB_USER=circle
# ROOFS_DB_PASSWORD=
# CIRCLE_APP_DB_NAME=circle

# Meta Conversions API (server Purchase). Pixel ID is already in index.html.
# Set the access token on Cloud Run only — never commit it.
# META_PIXEL_ID=1369877655256076
# META_CAPI_ACCESS_TOKEN=
