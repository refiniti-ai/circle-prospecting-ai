# —— Client (Vite) ——
# Google Maps browser key (address autocomplete + map preview on Buy Leads).
# Create in Google Cloud → APIs & Services → Credentials → Create API key (Browser).
# Enable: Maps JavaScript API + Places API. Link billing to the project.
# Restrict the key → HTTP referrers:
#   https://circleprospecting.ai/*
#   https://www.circleprospecting.ai/*
#   https://circle-prospecting-ai.web.app/*
#   https://circle-prospecting-ai.firebaseapp.com/*
#   http://localhost:5173/*
# Set here for local dev; must also be present when you run `npm run build` (Vite bakes it into the JS bundle).
VITE_GOOGLE_MAPS_API_KEY=
# Beta checkout — promo code BetaCPAI unlocks $0.50/home on all products (optional override).
# VITE_BETA_PROMO_CODE=BetaCPAI
# Hide non–Live Callers products on Buy Leads / pay link during beta. Set to false to restore all products.
# VITE_BETA_HIDE_AI_HYBRID=false
# Optional. Leave empty to use same-origin `/api/*`:
#   • Local: Vite proxies /api → API_PORT (see vite.config.ts).
#   • Production on Firebase Hosting: default firebase.json does NOT rewrite /api to Cloud Run.
#     Set VITE_API_BASE_URL to your public HTTPS API (e.g. https://circle-prospecting-api-xxxxx-uc.a.run.app),
#     then npm run build && firebase deploy --only hosting. On the API set CORS_ORIGIN to your *.web.app origin.
#     Same-domain /api is optional: deploy Cloud Run, then add the /api/** → Run rewrite back (see docs/firebase-phase1-deploy.md).
# NEVER bake http://localhost:8787 into a production build for *.web.app — checkout will fail.
VITE_API_BASE_URL=
# Optional: `.env.production` (committed) supplies VITE_* for `npm run build` on CI — see repo root `.env.production` example.
VITE_CONTACT_EMAIL=hello@circleprospecting.ai
# Cal.com booking link for header / homepage “Book call” CTAs (defaults to Greg’s 15-min event).
# VITE_BOOK_CALL_URL=https://cal.com/circleprospectingai-greg/15min
# Contact page (/contact): primary inbox shown in UI (align with server CONTACT_INBOX_EMAIL for where form mail goes).
# VITE_CONTACT_INBOX_EMAIL=info@circleprospecting.ai
# Pipe-separated address lines, e.g. VITE_CONTACT_ADDRESS=123 Main St|Austin, TX 78701
# VITE_CONTACT_ADDRESS=
# VITE_CONTACT_PHONE=+1 (555) 123-4567
# Optional social buttons (HTTPS URLs):
# VITE_SOCIAL_LINKEDIN=https://www.linkedin.com/company/...
# VITE_SOCIAL_X=https://x.com/...
# VITE_SOCIAL_FACEBOOK=https://www.facebook.com/...
# VITE_SOCIAL_INSTAGRAM=https://www.instagram.com/...
# Optional — only if you add Stripe.js in the browser (Checkout redirect does not need this today)
# VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxx
# Admin UI is available in production; access is enforced by server (admin login / JWT).

API_PORT=8787

# —— Public site URL (Stripe redirects, must match the URL you open in the browser) ——
# Production site URL (Stripe redirects, GHL pay links, must match the URL users open in the browser).
# Custom domain: https://circleprospecting.ai (also add www in Firebase Hosting if you use it).
APP_PUBLIC_URL=https://circleprospecting.ai

# —— API server (secrets; never commit .env) ——
# Stripe TEST keys: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_xxxxxxxx
# https://dashboard.stripe.com/test/webhooks — or from `stripe listen` CLI
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxx

# Optional: custom JWT signing key for dashboard/admin sessions (otherwise the API uses a built-in default).
# DASHBOARD_JWT_SECRET=

# Admin: username/password on /login?tab=admin → server returns a short-lived JWT.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
# Admin “forgot password” — must match the email you type on the login page; reset links are sent here.
# ADMIN_EMAIL=you@yourdomain.com
# Optional legacy: static Bearer for scripts/curl only — browser admin UI uses JWT from login instead.
# ADMIN_API_KEY=

# --- Lead packs + client dashboard (typical) ---
# Set on the API: STRIPE_SECRET_KEY, ADMIN_PASSWORD, APP_PUBLIC_URL (live site URL). Optional: DASHBOARD_JWT_SECRET.
# Same-domain Hosting→Cloud Run: leave VITE_API_BASE_URL empty when you build the SPA.
# STRIPE_WEBHOOK_SECRET on the API for purchase webhooks; point Stripe to https://circleprospecting.ai/api/webhooks/stripe
# Optional: Firestore vars below for purchase log + delivered leads; INBOUND_HMAC + POST /api/new-listing for listing ingest.

# Optional: HMAC for POST /api/new-listing
# INBOUND_HMAC_SECRET=

# Beta checkout (server validates promo + Live Callers only when enabled).
# BETA_PROMO_CODE=BetaCPAI
# BETA_HIDE_AI_HYBRID=false   # set to false to re-enable all products at checkout

# Optional GHL step-2 integration (provide webhook/API URLs that your GHL automation listens to)
# GHL_UPSERT_CONTACT_URL=
# GHL_CREATE_OPPORTUNITY_URL=
# GHL_BEARER_TOKEN=
#
# --- POST /api/generate-checkout (Stripe link generation triggered by GHL contact) ---
# Body: { contactId, email, plan, amount }. Returns Stripe checkout URL and (when configured)
# writes the URL back to the GHL contact's custom field (default key: stripe_checkout_url).
#
# Optional shared secret — if set, callers must send header X-Webhook-Token: <value>.
# GENERATE_CHECKOUT_TOKEN=
#
# Direct LeadConnector v2 API (preferred for writing the custom field back):
#   Requires GHL_BEARER_TOKEN (Location-level private integration token).
#   Defaults: GHL_API_BASE_URL=https://services.leadconnectorhq.com  GHL_API_VERSION=2021-07-28
# GHL_API_BASE_URL=https://services.leadconnectorhq.com
# GHL_API_VERSION=2021-07-28
# GHL_LOCATION_ID=                  # Sub-account id (from app.gohighlevel.com URL). Required for pay links + Buy Leads agent search (/api/ghl-contacts/search).
# GHL_CHECKOUT_URL_FIELD_ID=        # Custom field id from GHL → Settings → Custom Fields (preferred)
# GHL_CHECKOUT_URL_FIELD_KEY=stripe_checkout_url   # Fallback / key-based lookup
#
# Webhook fallback: if GHL_BEARER_TOKEN is not set but GHL_UPSERT_CONTACT_URL is,
# the URL update is POSTed to that webhook for your GHL workflow to handle.
#
# --- /pay/:contactId dynamic checkout page (POST /api/generate-pay-link) ---
# GHL workflow calls POST /api/generate-pay-link { contactId } → server returns a signed
# URL like https://YOUR-SITE/pay/<contactId>?t=<hmac> and writes it to the contact's
# custom field below. The page loads contact data (server uses GHL_BEARER_TOKEN) and
# offers the BuyLeads-style plan picker before sending the lead to Stripe.
# GHL_PAY_LINK_FIELD_KEY=pay_link_url
# Optional separate HMAC secret for pay-link tokens. Falls back to DASHBOARD_JWT_SECRET.
# PAY_LINK_SECRET=
#
# --- Production mail (required on the API host, e.g. Cloud Run) ---
# If none of these are set, GET /api/health returns "mailConfigured": false and receipts are skipped (logged only).
# 1) GHL_MAIL_WEBHOOK_URL — OR 2) RESEND_API_KEY (+ RESEND_FROM on a verified domain) — OR 3) SMTP_* complete set.
# Optional internal alerts: PURCHASE_NOTIFICATION_EMAIL=you@domain.com
#
# Transactional mail (purchase receipts, admin alerts, listing marketing) — prefer GHL over SMTP:
# Create an Inbound Webhook workflow in GHL; map JSON fields to "Send Email" (From = your GHL sender).
# Purchase receipts include `html` / `htmlBody` for a branded template — map one of those to the email HTML body in GHL (not only `text`).
# Optional: shown in client receipt footer (defaults to hello@circleprospecting.ai if unset).
# CONTACT_EMAIL=hello@yourdomain.com
# Inbox for /contact form submissions (defaults to info@circleprospecting.ai).
# CONTACT_INBOX_EMAIL=info@circleprospecting.ai
# When set, sendTextEmail uses this URL and ignores SMTP. Same GHL_BEARER_TOKEN if your webhook requires it.
# No space after = . Must receive POST + JSON (opening the URL in a browser will show an invalid-body error).
# GHL_MAIL_WEBHOOK_URL=https://services.leadconnectorhq.com/hooks/...
# Password reset emails send `html` / `htmlBody` plus merge fields `resetLink`, `passwordResetUrl`, `reset_url` — map HTML body or those fields in your workflow (not only plain `text`).
# Verify: GET /api/health → "mailTransport":"ghl" when this is set. With admin JWT: POST /api/admin/mail-test
# with body {"to":"you@domain.com"} (or omit and use ADMIN_EMAIL) → sends a test message through GHL.
#
# Resend (https://resend.com) — simple API email if you do not use GHL. Set API key in Cloud Run; verify a domain for production From.
# RESEND_API_KEY=re_...
# RESEND_FROM="Circle Prospecting AI <notifications@yourdomain.com>"

# Optional Firebase Firestore (Admin SDK — bypasses security rules; use same GCP project as Hosting if you want).
# In Firebase Console: enable Firestore (Native). Then add credentials below.
# What syncs today: listing orders (orderStore → FIREBASE_ORDERS_COLLECTION), Stripe purchase log (purchaseConfirmStore).
# Lead inventory CSV + dashboard rows still use server/data JSON unless you extend leadStore.
#
# Console → Project settings → Service accounts → Generate new private key (JSON).
# Either FIREBASE_SERVICE_ACCOUNT_JSON (whole JSON string) or FIREBASE_SERVICE_ACCOUNT_PATH (file path from repo root).
# FIREBASE_PROJECT_ID=circle-prospecting-ai
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/serviceAccountKey.json
# Docker/Cloud Run: keep secrets/ out of the image (.dockerignore). Prefer Secret Manager mounting FIREBASE_SERVICE_ACCOUNT_JSON or ADC on GCP.
# On Cloud Run / GAE / many Functions, ADC is auto-detected. Locally: use JSON path, or gcloud +:
# FIREBASE_USE_ADC=1
# FIREBASE_ORDERS_COLLECTION=orders
# Admin purchase log (Stripe webhook) — defaults to purchase_notifications
# FIREBASE_PURCHASES_COLLECTION=purchase_notifications
# Client dashboard passwords (email login) — defaults to client_accounts
# FIREBASE_CLIENT_ACCOUNTS_COLLECTION=client_accounts
# Assigned lead rows for the client dashboard (defaults to client_delivery_leads)
# FIREBASE_CLIENT_LEADS_COLLECTION=client_delivery_leads
#
# --- Client workflow / Firestore smoke ---
# 1) Copy this file to .env and fill STRIPE_*, admin password vars, optional Firestore vars.
# 2) npm run workflow:check   → shows Firestore connected or not; pings /api/health if API is up.
# 3) npm run firestore:smoke  → writes Firestore doc _smoke/api-smoke (requires credentials).
# 4) npm run dev → test /buy-leads → Stripe test checkout → /dashboard?claim=1&session_id=...
# 5) GET /api/health includes "firestore": true|false so you can verify linkage from curl or monitoring.

# Optional SMTP (only used if GHL_MAIL_WEBHOOK_URL is not set; for local/dev or non-GHL sends)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=no-reply@circleprospecting.ai
# Comma-separated internal recipients for purchase alerts
# PURCHASE_NOTIFICATION_EMAIL=owner@circleprospecting.ai,ops@circleprospecting.ai

# Upstream order API (optional)
# ORDER_UPSTREAM_URL=
# ORDER_UPSTREAM_TOKEN=

# Lead pack pricing (cents per pack) — first number is count of leads, second is price
LEAD_PACKS=10:9900,25:19900,50:34900,100:59900

# Checkout inventory floor — buyers can purchase up to this many homes even if Admin CSV has fewer rows (default 8000).
# LEAD_CHECKOUT_INVENTORY_MIN=8000

# CORS for production — include custom domain + Firebase backup + local dev:
# CORS_ORIGIN=https://circleprospecting.ai,https://www.circleprospecting.ai,https://circle-prospecting-ai.web.app,http://localhost:5173
