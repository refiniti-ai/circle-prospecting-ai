# —— Client (Vite) ——
VITE_GOOGLE_MAPS_API_KEY=
# Optional. Leave empty to use same-origin `/api/*`:
#   • Local: Vite proxies /api → API_PORT (see vite.config.ts).
#   • Production on Firebase Hosting: default firebase.json does NOT rewrite /api to Cloud Run.
#     Set VITE_API_BASE_URL to your public HTTPS API (e.g. https://circle-prospecting-api-xxxxx-uc.a.run.app),
#     then npm run build && firebase deploy --only hosting. On the API set CORS_ORIGIN to your *.web.app origin.
#     Same-domain /api is optional: deploy Cloud Run, then add the /api/** → Run rewrite back (see docs/firebase-phase1-deploy.md).
# NEVER bake http://localhost:8787 into a production build for *.web.app — checkout will fail.
VITE_API_BASE_URL=
# Optional: `.env.production` (committed) supplies VITE_* for `npm run build` on CI — see repo root `.env.production` example.
VITE_CONTACT_EMAIL=hello@circleprospecting.ai
# Optional — only if you add Stripe.js in the browser (Checkout redirect does not need this today)
# VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxx
# Show /admin/leads in production (optional; always visible in dev)
# VITE_SHOW_ADMIN=1

API_PORT=8787

# —— Public site URL (Stripe redirects, must match the URL you open in the browser) ——
APP_PUBLIC_URL=http://localhost:5173

# —— API server (secrets; never commit .env) ——
# Stripe TEST keys: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_xxxxxxxx
# https://dashboard.stripe.com/test/webhooks — or from `stripe listen` CLI
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxx

# For dashboard JWT signing (32+ random chars in production)
DASHBOARD_JWT_SECRET=change-me-to-a-long-random-string-for-production

# Admin: username/password on /login?tab=admin → server returns a short-lived JWT (same secret as client dashboard).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
# Optional legacy: static Bearer for scripts/curl only — browser admin UI uses JWT from login instead.
# ADMIN_API_KEY=

# --- Lead packs + client dashboard (typical) ---
# Set on the API: STRIPE_SECRET_KEY, DASHBOARD_JWT_SECRET, ADMIN_USERNAME, ADMIN_PASSWORD, APP_PUBLIC_URL (live site URL).
# Same-domain Hosting→Cloud Run: leave VITE_API_BASE_URL empty when you build the SPA.
# STRIPE_WEBHOOK_SECRET on the API for purchase webhooks; point Stripe to https://YOUR_SITE/api/webhooks/stripe
# Optional: Firestore vars below for purchase log + delivered leads; INBOUND_HMAC + POST /api/new-listing for listing ingest.

# Optional: HMAC for POST /api/new-listing
# INBOUND_HMAC_SECRET=

# Optional GHL step-2 integration (provide webhook/API URLs that your GHL automation listens to)
# GHL_UPSERT_CONTACT_URL=
# GHL_CREATE_OPPORTUNITY_URL=
# GHL_BEARER_TOKEN=
#
# Transactional mail (purchase receipts, admin alerts, listing marketing) — prefer GHL over SMTP:
# Create an Inbound Webhook workflow in GHL; map JSON fields to "Send Email" (From = your GHL sender).
# When set, sendTextEmail uses this URL and ignores SMTP. Same GHL_BEARER_TOKEN if your webhook requires it.
# No space after = . Must receive POST + JSON (opening the URL in a browser will show an invalid-body error).
# GHL_MAIL_WEBHOOK_URL=https://services.leadconnectorhq.com/hooks/...

# Optional Firebase Firestore (Admin SDK — bypasses security rules; use same GCP project as Hosting if you want).
# In Firebase Console: enable Firestore (Native). Then add credentials below.
# What syncs today: listing orders (orderStore → FIREBASE_ORDERS_COLLECTION), Stripe purchase log (purchaseConfirmStore).
# Lead inventory CSV + dashboard rows still use server/data JSON unless you extend leadStore.
#
# Console → Project settings → Service accounts → Generate new private key (JSON).
# Either FIREBASE_SERVICE_ACCOUNT_JSON (whole JSON string) or FIREBASE_SERVICE_ACCOUNT_PATH (file path from repo root).
# FIREBASE_PROJECT_ID=circle-prospecting-ai
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/serviceAccountKey.json
# Docker/Cloud Run: keep secrets/ out of the image (.dockerignore). Prefer Secret Manager mounting FIREBASE_SERVICE_ACCOUNT_JSON or ADC on GCP.
# On Cloud Run / GAE / many Functions, ADC is auto-detected. Locally: use JSON path, or gcloud +:
# FIREBASE_USE_ADC=1
# FIREBASE_ORDERS_COLLECTION=orders
# Admin purchase log (Stripe webhook) — defaults to purchase_notifications
# FIREBASE_PURCHASES_COLLECTION=purchase_notifications
# Client dashboard passwords (email login) — defaults to client_accounts
# FIREBASE_CLIENT_ACCOUNTS_COLLECTION=client_accounts
# Assigned lead rows for the client dashboard (defaults to client_delivery_leads)
# FIREBASE_CLIENT_LEADS_COLLECTION=client_delivery_leads
#
# --- Client workflow / Firestore smoke ---
# 1) Copy this file to .env and fill STRIPE_*, DASHBOARD_JWT_SECRET, admin password vars, optional Firestore vars.
# 2) npm run workflow:check   → shows Firestore connected or not; pings /api/health if API is up.
# 3) npm run firestore:smoke  → writes Firestore doc _smoke/api-smoke (requires credentials).
# 4) npm run dev → test /buy-leads → Stripe test checkout → /dashboard?claim=1&session_id=...
# 5) GET /api/health includes "firestore": true|false so you can verify linkage from curl or monitoring.

# Optional SMTP (only used if GHL_MAIL_WEBHOOK_URL is not set; for local/dev or non-GHL sends)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=no-reply@circleprospecting.ai
# Comma-separated internal recipients for purchase alerts
# PURCHASE_NOTIFICATION_EMAIL=owner@circleprospecting.ai,ops@circleprospecting.ai

# Upstream order API (optional)
# ORDER_UPSTREAM_URL=
# ORDER_UPSTREAM_TOKEN=

# Lead pack pricing (cents per pack) — first number is count of leads, second is price
LEAD_PACKS=10:9900,25:19900,50:34900,100:59900

# CORS for production — must include every browser origin that calls your API (match VITE_API_BASE_URL host’s callers):
# CORS_ORIGIN=https://circle-prospecting-ai.web.app,http://localhost:5173
